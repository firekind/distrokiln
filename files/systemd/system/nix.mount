[Unit]
Description=Nix store overlay
DefaultDependencies=no
After=local-fs.target
Before=nix-daemon.service nix-daemon.socket
RequiresMountsFor=/var

[Mount]
What=overlay
Where=/nix
Type=overlay
Options=lowerdir=/usr/share/nix-store,upperdir=/var/lib/nix-store,workdir=/var/cache/nix-store

[Install]
WantedBy=local-fs.target
